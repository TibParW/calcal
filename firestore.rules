rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lock down user profiles, food logs, and private settings
    match /users/{userId} {
      // User can only access their own root document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User can only access their own food logs subcollection
      match /food_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User can only access their own settings subcollection (including Gemini API Key)
      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
